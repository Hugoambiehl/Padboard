<?xml version="1.0" encoding="utf-8"?>
<!--
  USB: plain ws:// to 127.0.0.1, forwarded to the PC by `adb reverse` (the
  traffic never leaves the cable). Wi-Fi: wss:// with the PC's key pinned in
  code (connection/Pinning.kt), so cleartext stays forbidden everywhere else.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
