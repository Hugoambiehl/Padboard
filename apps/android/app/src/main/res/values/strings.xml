<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Default texts (English); French in values-fr. Same keys in both (Lint MissingTranslation). -->
    <string name="app_name" translatable="false">Padboard</string>

    <!-- Setup (no paired PC), layout of Pairing.dc.html -->
    <string name="setup_title">Pair the tablet\nwith your PC</string>
    <string name="setup_body">On your PC, click “Pair a device” in Padboard: a 6-digit code shows up. Pick your PC here, then type the code. You only do this once.</string>
    <string name="setup_usb_hint">Over USB, no code needed: just plug in the tablet (USB debugging on), it connects automatically.</string>
    <string name="setup_found">PCs found on the network</string>
    <string name="setup_searching">Looking for other PCs…</string>
    <string name="setup_incompatible">Incompatible Padboard version</string>
    <string name="setup_manual">Type the PC’s address</string>
    <string name="setup_host_label">PC’s IP address</string>
    <string name="setup_invalid_host">Invalid address.</string>
    <string name="setup_manual_connect">Connect</string>
    <string name="setup_back">Back to the grid</string>
    <string name="pairing_unreachable">Cannot reach this PC over Wi-Fi. Check that Wi-Fi is on in Padboard on the PC and that both devices are on the same network.</string>
    <string name="pairing_lost">The connection to the PC was lost while pairing. Start again.</string>

    <!-- PIN entry -->
    <string name="pin_title">Code shown\non your PC</string>
    <string name="pin_server">Pairing with %1$s</string>
    <string name="pin_body">Type the 6-digit code shown in the “Pair a tablet” window of your PC.</string>
    <string name="pin_code_label">Code shown on your PC</string>
    <!-- "3 of 6 digits typed": a progress, not a quantity. -->
    <string name="pin_digits_description" tools:ignore="PluralsCandidate">%1$d of %2$d digits typed</string>
    <string name="pin_check_title">Check that your PC shows this code</string>
    <string name="pin_check_hint">If it is different, do not type the code and cancel: another device is pretending to be your PC.</string>
    <string name="pin_checking">Checking…</string>
    <plurals name="pin_invalid">
        <item quantity="one">Wrong code. %1$d attempt left.</item>
        <item quantity="other">Wrong code. %1$d attempts left.</item>
    </plurals>
    <string name="pin_expired">The code has expired. Show a new code on the PC.</string>
    <string name="pin_locked">Too many attempts: show a new code on the PC.</string>
    <string name="pin_no_code">No code shown on the PC: click “Pair a device”.</string>
    <string name="pin_erase">Erase</string>
    <string name="pin_cancel">Cancel</string>

    <!-- Searching / failures -->
    <string name="starting">Starting…</string>
    <string name="searching_title">Looking for %1$s…</string>
    <string name="searching_body">Plug the tablet in over USB, or check that Padboard runs on the PC with Wi-Fi on and that both devices are on the same network.</string>
    <string name="failure_incompatible">The Padboard version on the PC does not match this tablet’s. Update Padboard on the PC: it then updates the tablet.</string>
    <string name="retry">Try again</string>
    <string name="cancel">Cancel</string>

    <!-- Forget the paired PC -->
    <string name="forget_button">Pair another PC</string>
    <string name="forget_title">Forget %1$s?</string>
    <string name="forget_body">The tablet will no longer connect to this PC over Wi-Fi until it is paired again. USB still works.</string>
    <string name="forget_confirm">Forget this PC</string>
    <string name="usb_only_body">Connected over USB. Pair the tablet with this PC to also use it over Wi-Fi, without the cable.</string>
    <string name="pair_wifi">Pair over Wi-Fi</string>

    <!-- Grid -->
    <string name="transport_usb">USB</string>
    <string name="transport_wifi">Wi-Fi</string>
    <string name="pill_latency">%1$s · %2$d ms</string>
    <string name="pill_reconnecting">Reconnecting…</string>
    <string name="kiosk_exit_title">Leave kiosk mode?</string>
    <string name="kiosk_exit_body">Padboard will no longer be locked on screen nor be the home screen, and the tablet becomes an ordinary tablet again (status bar, lock screen). To turn it back on: plug the tablet in over USB, then “Turn on kiosk mode” in the PC’s connections.</string>
    <string name="kiosk_exit_confirm">Leave kiosk mode</string>
    <string name="disconnected_title">Connection to the PC lost</string>
    <string name="disconnected_body_wifi">Looking over the USB cable and Wi-Fi. Check that Padboard runs on the PC.</string>
    <string name="disconnected_body_usb">Plug the USB cable back in, or pair the tablet over Wi-Fi to do without it.</string>
    <string name="disconnected_next_attempt">Next attempt in %1$d s</string>
    <string name="disconnected_trying">Trying…</string>
    <string name="disconnected_retry">Try now</string>
    <string name="connection_pill_description">%1$s, %2$s. Tap for the connection options.</string>
    <!-- "Page 2 of 3": a position, not a quantity. -->
    <string name="page_indicator_description" tools:ignore="PluralsCandidate">Page %1$d of %2$d</string>
    <string name="layout_waiting">Receiving the grid…</string>
    <string name="folder_back">Back (folder %1$s)</string>
    <string name="action_failed">The action failed on the PC.</string>
    <string name="screensaver_mic_muted">MIC MUTED</string>
    <string name="screensaver_recording">REC</string>
    <string name="screensaver_live">LIVE</string>
    <string name="screensaver_offline">PC not connected</string>
    <string name="about_open">About and licenses</string>
    <string name="about_title">About</string>
    <string name="about_version">Padboard, version %1$s</string>
    <string name="about_license">Free software, released under the GNU GPL version 3 or later.</string>
    <string name="about_warranty">Provided without any warranty, to the extent permitted by law.</string>
    <string name="about_source">Source code</string>
    <string name="about_back">Back</string>
    <string name="about_section_app">APP</string>
    <string name="about_section_assets">FONTS AND ICONS</string>
    <string name="about_section_libraries">LIBRARIES</string>
    <string name="about_no_text">License text not included: see the component’s repository.</string>
    <!-- Updates sent by the PC -->
    <string name="update_only_tablet_older">The Padboard version on this tablet does not match the one on %1$s. Update the tablet from the PC: connections view, “Update” button (over USB, or over Wi-Fi in kiosk mode).</string>
    <string name="update_only_pc_older">This tablet has a newer version of Padboard than %1$s. Update Padboard on the PC.</string>
    <string name="update_title">Updating Padboard</string>
    <string name="update_receiving">Receiving version %1$s… %2$d%%</string>
    <string name="update_installing">Installing version %1$s: Padboard restarts by itself.</string>
    <string name="update_failed">Version %1$s was not installed: %2$s</string>
    <string name="update_reason_not_device_owner">the tablet is no longer in kiosk mode (update it over USB).</string>
    <string name="update_reason_not_newer">this version or a newer one is already installed.</string>
    <string name="update_reason_wrong_package">the file is not Padboard.</string>
    <string name="update_reason_bad_certificate">it is not signed with Padboard’s key.</string>
    <string name="update_reason_bad_hash">the file was damaged on the way.</string>
    <string name="update_reason_transfer_failed">the transfer stopped.</string>
    <string name="update_reason_install_failed">Android refused to install it.</string>
    <string name="update_reason_busy">another update is in progress.</string>
    <string name="update_ok">OK</string>
</resources>
