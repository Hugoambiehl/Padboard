    "@vueuse/core": "^15.0.0",
    "lucide": "^1.71.0",
    "lucide-vue-next": "^1.0.0",
    "motion-v": "~2.11.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "~2.11.5",
    "@types/node": "~26.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
