{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Padboard",
  "version": "0.1.0",
  "identifier": "io.github.hugoambiehl.padboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Padboard",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 680,
        "backgroundColor": "#0E0F12",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "license": "GPL-3.0-or-later",
    "targets": [
      "nsis",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Turns an Android tablet into a touch control surface for your PC",
    "category": "Utility",
    "copyright": "Copyright (C) 2026 Padboard contributors. GPL-3.0-or-later.",
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/padboard/copyright": "../../../LICENSE"
        }
      }
    },
    "longDescription": "Padboard runs actions on your PC (shortcuts, media, volume, microphone, OBS, apps) from a grid of buttons shown on a dedicated Android tablet, over USB or Wi-Fi, without any cloud service."
  }
}
